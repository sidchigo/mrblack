# Environment variables for Mr. Black

# Redis Configuration (Upstash)
# Leave empty for automatic local in-memory store in development
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OpenAI-compatible LLM Configuration (OpenAI, Groq, OpenRouter, LocalAI)
# If using Groq: set GROQ_API_KEY and GROQ_API_KEY will auto-target Groq's endpoint
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
GROQ_API_KEY=""

# Generation Rate Limits (as per design-decisions.md)
RATE_LIMIT_PER_IP_RPM=2
RATE_LIMIT_GLOBAL_RPM=5
RATE_LIMIT_GLOBAL_RPD=900
